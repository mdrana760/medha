<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Medha" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/medha_primary</item>
        <item name="colorPrimaryDark">@color/medha_primary_dark</item>
        <item name="colorSecondary">@color/medha_secondary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/medha_primary_dark</item>
    </style>

    <style name="Theme.Medha.Splash" parent="Theme.Medha">
        <item name="android:windowBackground">@color/medha_primary</item>
        <item name="android:statusBarColor">@color/medha_primary</item>
    </style>

    <style name="Theme.Medha.Transparent" parent="Theme.Medha">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Card-style container reused across screens. -->
    <style name="MedhaCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
